# CloudDeploy Environment Configuration
# Copy this file to .env and adjust values for your local environment.

# Django Secret Key (generate a secure, random string for non-development environments)
SECRET_KEY=django-insecure-replace-with-secure-random-secret-key

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated list of hostnames or IP addresses)
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Configuration Note:
# SQLite is configured by default for Phase 1.
# Future phases can configure PostgreSQL without code changes:
# DATABASE_URL=postgres://user:password@localhost:5432/clouddeploy

